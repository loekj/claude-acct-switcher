has_swiftc() { xcode-select -p >/dev/null 2>&1 && xcrun --find swiftc >/dev/null 2>&1; }

build_menubar() {
  local src="$SCRIPT_DIR/menubar/VdmMenu.swift" tmp="$SCRIPT_DIR/.VdmMenu.app.new"
  if [[ ! -f "$src" ]]; then
    # Upgraded by an older vdm, which did not copy menubar/: fetch it now
    local t; t=$(mktemp -d)
    if git clone --depth 1 --quiet "${VDM_REPO_URL:-https://github.com/loekj/claude-acct-switcher.git}" "$t" 2>/dev/null && [[ -f "$t/menubar/VdmMenu.swift" ]]; then
      mkdir -p "$SCRIPT_DIR/menubar" && cp "$t"/menubar/*.swift "$SCRIPT_DIR/menubar/"
    fi
    rm -rf "$t"
    [[ -f "$src" ]] || { echo -e "${RED}menubar/VdmMenu.swift is missing.${NC} Run: vdm upgrade"; return 1; }
  fi
  rm -rf "$tmp"; mkdir -p "$tmp/Contents/MacOS"
  python3 - "$tmp/Contents/Info.plist" <<'PY'
import plistlib, sys
plistlib.dump({"CFBundleName": "VdmMenu", "CFBundleDisplayName": "vdm", "CFBundleIdentifier": "io.github.loekj.vdm.menubar",
  "CFBundleExecutable": "VdmMenu", "CFBundlePackageType": "APPL", "CFBundleShortVersionString": "1.0", "LSUIElement": True,
  "NSAppTransportSecurity": {"NSAllowsLocalNetworking": True}}, open(sys.argv[1], "wb"))
PY
  echo -e "  ${DIM}Building the menu bar app (about a minute the first time)…${NC}"
  if ! xcrun swiftc -O -swift-version 5 -o "$tmp/Contents/MacOS/VdmMenu" "$src" >"$SCRIPT_DIR/menubar-build.log" 2>&1; then
    rm -rf "$tmp"
    echo -e "${RED}The build failed.${NC} See ${DIM}$SCRIPT_DIR/menubar-build.log${NC}"
    return 1
  fi
  codesign --force -s - "$tmp" >/dev/null 2>&1 || true   # ad-hoc signature, made on this Mac
  rm -rf "$MENU_APP"; mv "$tmp" "$MENU_APP"
}

cmd_menubar() {
  local action="${1:-status}"
  case "$action" in
    on|install|rebuild)
      if ! has_swiftc; then
        echo -e "${YELLOW}The menu bar icon needs Apple's Command Line Tools (free, includes swiftc).${NC}"
        echo -e "  Install them: ${CYAN}xcode-select --install${NC}   then run: ${CYAN}vdm menubar on${NC}"
        echo -e "  ${DIM}vdm itself works without them.${NC}"
        return 1
      fi
      build_menubar || return 1
      write_plist "$MENU_PLIST" "$MENU_LABEL" "$MENU_APP/Contents/MacOS/VdmMenu"
      launchctl bootout "$GUI_DOMAIN/$MENU_LABEL" 2>/dev/null || true
      if ! load_agent "$MENU_LABEL" "$MENU_PLIST"; then
        echo -e "${RED}The menu bar icon did not start.${NC}"
        return 1
      fi
      echo -e "${GREEN}✓${NC} Menu bar icon on (it starts when you log in)."
      ;;
    off|uninstall)
      launchctl bootout "$GUI_DOMAIN/$MENU_LABEL" 2>/dev/null || true
      rm -f "$MENU_PLIST"; rm -rf "$MENU_APP"
      echo -e "${GREEN}✓${NC} Menu bar icon off."
      ;;
    status)
      if [[ -f "$MENU_PLIST" ]]; then echo -e "${GREEN}●${NC} Menu bar icon on"; else echo -e "${DIM}●${NC} Menu bar icon off. Turn it on: ${CYAN}vdm menubar on${NC}"; fi
      ;;
    *) echo -e "${RED}Usage: vdm menubar [on|off|status]${NC}"; return 1 ;;
  esac
}

cmd_upgrade() {
  local REPO_URL="${VDM_REPO_URL:-https://github.com/loekj/claude-acct-switcher.git}"   # env: tests
  local tmpdir
  tmpdir=$(mktemp -d)
  # Ensure cleanup on any exit from this function
  trap "rm -rf '$tmpdir'" RETURN

  echo ""
  echo -e "${BOLD}  Upgrading Van Damme-o-Matic…${NC}"
  echo ""

  # Fetch latest from remote
  echo -e "  ${DIM}Fetching latest version…${NC}"
  if ! git clone --depth 1 "$REPO_URL" "$tmpdir" 2>/dev/null; then
    echo -e "  ${RED}Failed to fetch from $REPO_URL${NC}"
    return 1
  fi
  # Shallow clone may miss tags — fetch them explicitly
  git -C "$tmpdir" fetch --tags --quiet 2>/dev/null || true

  # Compare versions (prefer semver tag, fall back to commit hash)
  local current_hash=""
  if [[ -f "$SCRIPT_DIR/.version" ]]; then
    current_hash=$(cat "$SCRIPT_DIR/.version")
  fi
  local latest_hash
  latest_hash=$(git -C "$tmpdir" describe --tags --abbrev=0 2>/dev/null \
    || git -C "$tmpdir" rev-parse --short HEAD 2>/dev/null)

  # Same version, but a module is missing (an older upgrade did not know about it): repair
  local missing=""
  for f in "$tmpdir"/*.mjs "$tmpdir"/menubar/*.swift; do
    [[ -f "$f" && ! -f "$SCRIPT_DIR/${f#"$tmpdir"/}" ]] && missing="$missing ${f#"$tmpdir"/}"
  done
  if [[ -n "$current_hash" && "$current_hash" == "$latest_hash" && -z "$missing" ]]; then
    echo -e "  ${GREEN}✓${NC} Already on the latest version (${DIM}$current_hash${NC})"
    return 0
  fi
  [[ -n "$missing" ]] && echo -e "  ${DIM}Adding missing files:${missing}${NC}"

  # Verify the fetched repo has the files we need
  for f in vdm dashboard.mjs lib.mjs history.mjs install-hooks.sh; do
    if [[ ! -f "$tmpdir/$f" ]]; then
      echo -e "  ${RED}Fetched repo is missing $f — aborting.${NC}"
      return 1
    fi
  done

  # Check if dashboard is running (PID file or listening on port)
  local dashboard_was_running=false
  if [[ -f "$DASHBOARD_PID_FILE" ]] && kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
    dashboard_was_running=true
  elif lsof -iTCP:"$DASHBOARD_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
    dashboard_was_running=true
  fi

  # Stop dashboard before overwriting files
  if [[ "$dashboard_was_running" == "true" ]]; then
    echo -e "  ${DIM}Stopping dashboard…${NC}"
    cmd_dashboard stop >/dev/null || true
    # Also kill any process on the port not tracked by PID file (e.g. shell auto-start)
    local port_pid
    port_pid=$(lsof -iTCP:"$DASHBOARD_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) || true
    if [[ -n "$port_pid" ]]; then
      kill "$port_pid" 2>/dev/null || true
    fi
  fi

  # Overwrite only code files — never touch accounts/, config.json,
  # activity-log.json, .label files, or any other user data.
  # Each file is written next to its target and renamed over it, so a running vdm (bash
  # reads its script as it goes) keeps reading the old file, never a half-written one.
  echo -e "  ${DIM}Updating files…${NC}"
  local files=(vdm install-hooks.sh)
  for f in "$tmpdir"/*.mjs; do files+=("$(basename "$f")"); done
  for f in "${files[@]}"; do
    if ! { cp "$tmpdir/$f" "$SCRIPT_DIR/.$f.new" && mv -f "$SCRIPT_DIR/.$f.new" "$SCRIPT_DIR/$f"; }; then
      rm -f "$SCRIPT_DIR/.$f.new" 2>/dev/null || true
      echo -e "  ${RED}Could not update $f. Nothing else was changed after it; run vdm upgrade again.${NC}"
      [[ "$dashboard_was_running" == "true" ]] && cmd_dashboard start
      return 1
    fi
  done
  chmod +x "$SCRIPT_DIR/vdm"
  if [[ -d "$tmpdir/menubar" ]]; then
    mkdir -p "$SCRIPT_DIR/menubar"
    cp "$tmpdir"/menubar/*.swift "$SCRIPT_DIR/menubar/" 2>/dev/null || true
  fi

  # Write version marker
  echo "$latest_hash" > "$SCRIPT_DIR/.version"

  # Remove hooks older versions installed
  if [[ -f "$SCRIPT_DIR/install-hooks.sh" ]]; then
    local _VDM_NEW_UPGRADE=1
    source "$SCRIPT_DIR/install-hooks.sh"
    if has_legacy_hooks; then
      remove_legacy_hooks && echo -e "  ${GREEN}✓${NC} Removed old token-tracking hooks (no longer needed)" || true
    else
      remove_legacy_hooks 2>/dev/null || true
    fi
  fi

  # The new script's shell block (this running script is the old version)
  "$SCRIPT_DIR/vdm" _setup-shell >/dev/null 2>&1 || true

  # Restart dashboard if it was running (the new script writes the plist and restarts it)
  if daemon_installed; then
    "$SCRIPT_DIR/vdm" _write-daemon-plist >/dev/null 2>&1 || true
    echo -e "  ${DIM}Restarting vdm (daemon)…${NC}"
    "$SCRIPT_DIR/vdm" daemon restart >/dev/null && echo -e "  ${GREEN}✓${NC} vdm running" || echo -e "  ${RED}vdm did not start.${NC} See ${DIM}$DAEMON_LOG${NC}"
  elif [[ "$dashboard_was_running" == "true" ]]; then
    echo -e "  ${DIM}Restarting dashboard…${NC}"
    cmd_dashboard start
  fi
  # Rebuild the menu bar icon from the new source
  if [[ -f "$MENU_PLIST" ]]; then echo -e "  ${DIM}Rebuilding the menu bar icon…${NC}"; "$SCRIPT_DIR/vdm" menubar on >/dev/null 2>&1 && echo -e "  ${GREEN}✓${NC} Menu bar icon rebuilt" || echo -e "  ${YELLOW}Menu bar icon not rebuilt.${NC} Run: vdm menubar on"; fi
  if ! daemon_installed; then
    echo -e "  ${DIM}New: run vdm as a daemon (starts at login, restarts after a crash):${NC} ${CYAN}vdm daemon on${NC}"
  fi

  echo ""
  if [[ -n "$current_hash" && "$current_hash" == "$latest_hash" ]]; then
    echo -e "  ${GREEN}✓${NC} Repaired ${BOLD}$latest_hash${NC} (added missing files)"
  elif [[ -n "$current_hash" ]]; then
    echo -e "  ${GREEN}✓${NC} Upgraded ${DIM}$current_hash${NC} → ${BOLD}$latest_hash${NC}"
  else
    echo -e "  ${GREEN}✓${NC} Upgraded to ${BOLD}$latest_hash${NC}"
  fi
  echo ""

  log_activity "upgrade" "from=${current_hash:-unknown}" "to=$latest_hash"
}

cmd_tokens() {
  # Token usage from the proxy's usage store (all traffic, incl. cache tokens)
  local repo=""
  local branch=""
  local days=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)     repo="$2"; shift 2 ;;
      --branch)   branch="$2"; shift 2 ;;
      --days)     days="$2"; shift 2 ;;
      *)          shift ;;
    esac
  done

  local url="http://localhost:$DASHBOARD_PORT/api/usage?days=$days"
  if [[ -n "$repo" ]]; then
    url="${url}&repo=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$repo" 2>/dev/null)"
  fi
  if [[ -n "$branch" ]]; then
    url="${url}&branch=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$branch" 2>/dev/null)"
  fi

  local usage
  usage=$(curl -s --max-time 5 "$url" 2>/dev/null) || {
    echo -e "${RED}Could not connect to dashboard. Is it running?${NC}"
    return 1
  }

  echo ""
  echo -e "${BOLD}  Token Usage${NC}"
  echo -e "  ────────────────────────────────────────────"
  [[ -n "$repo" ]] && echo -e "  ${DIM}Repo: $repo${NC}"
  [[ -n "$branch" ]] && echo -e "  ${DIM}Branch: $branch${NC}"
  echo -e "  ${DIM}Period: last $days day(s) · cost = same usage at API prices${NC}"
  echo ""

  echo "$usage" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print('  Could not read usage data.'); sys.exit(0)
t = d.get('totals', {})
if not t.get('requests'):
    print('  No token usage recorded in this period.'); sys.exit(0)

def prompt(x): return x.get('input', 0) + x.get('cacheRead', 0) + x.get('cacheWrite5m', 0) + x.get('cacheWrite1h', 0)
def hit(x):
    p = prompt(x)
    return f\"{x.get('cacheRead', 0) / p * 100:.0f}%\" if p else '-'

def rows(title, m):
    print(f'  {title}')
    for k, v in sorted(m.items(), key=lambda kv: -kv[1].get('cost', 0)):
        print(f\"    {k[:38]:<38} {v.get('requests', 0):>7,} calls  {prompt(v) + v.get('output', 0):>14,} tok  cache {hit(v):>4}  \${v.get('cost', 0):>9,.2f}\")
    print()

rows('By model', d.get('byModel', {}))
rows('By account', d.get('byAccount', {}))
print(f\"  Total: {t['requests']:,} calls · {prompt(t) + t.get('output', 0):,} tokens · cache hit {hit(t)} · \${t.get('cost', 0):,.2f} at API prices\")
plans = [p for p in d.get('plans', []) if p.get('planCost')]
if plans:
    pc = sum(p['planCost'] for p in plans); ac = sum(p['apiCost'] for p in plans)
    print(f\"  Plans: \${pc:,.2f} for this period ({ac / pc:.1f}x value)\" if pc else '')
" 2>/dev/null
  echo ""
}

cmd_logs() {
  local filter="${1:-}"

  # Check if dashboard is running
  if ! curl -s --max-time 2 "http://localhost:$DASHBOARD_PORT/health" >/dev/null 2>&1; then
    echo -e "${RED}Dashboard is not running. Start it with: vdm dashboard${NC}"
    return 1
  fi

  echo -e "${BOLD}  Van Damme-o-Matic — Live Proxy Logs${NC}"
  echo -e "  ─────────────────────────────────────────────"
  if [[ -n "$filter" ]]; then
    echo -e "  ${DIM}Filter: $filter${NC}"
  fi
  echo -e "  ${DIM}Press Ctrl-C to stop${NC}"
  echo ""

  # Stream SSE logs, parse the JSON data lines, colorize by tag
  curl -s -N "http://localhost:$DASHBOARD_PORT/api/logs/stream" 2>/dev/null | while IFS= read -r line; do
    # SSE format: "data: {...}"
    if [[ "$line" == data:* ]]; then
      local json="${line#data: }"
      local log_line
      log_line=$(echo "$json" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    tag = d.get('tag', '')
    line = d.get('line', d.get('msg', ''))
    # Color coding
    colors = {
        'error': '\033[0;31m',     # red
        'warn': '\033[1;33m',      # yellow
        'switch': '\033[0;36m',    # cyan
        'refresh': '\033[0;34m',   # blue
        'proactive': '\033[0;35m', # magenta
        'info': '\033[0m',         # default
        'system': '\033[0;32m',    # green
    }
    color = colors.get(tag, '\033[2m')  # dim for unknown
    reset = '\033[0m'
    print(f'{color}{line}{reset}')
except:
    pass
" 2>/dev/null)
      if [[ -n "$log_line" ]]; then
        if [[ -z "$filter" ]] || echo "$log_line" | grep -qi "$filter" 2>/dev/null; then
          echo -e "  $log_line"
        fi
      fi
    fi
  done
}

cmd_history() {
  # `vdm history --days 7` and `vdm history --all` mean "list"
  local sub="list"
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then sub="help"; shift
  elif [[ -n "${1:-}" && "$1" != -* ]]; then sub="$1"; shift; fi
  if [[ ! -f "$SCRIPT_DIR/history.mjs" ]]; then
    echo -e "${RED}history.mjs is missing.${NC} Run: vdm upgrade"
    return 1
  fi
  local hist=(env NODE_NO_WARNINGS=1 CSW_PORT="$DASHBOARD_PORT" node "$SCRIPT_DIR/history.mjs" cli)
  case "$sub" in
    resume|continue)
      if [[ -z "${1:-}" ]]; then echo -e "${RED}Usage: vdm history $sub <id>${NC}"; return 1; fi
      local out dir cmd arg
      out=$("${hist[@]}" launch "$sub" "$1") || return $?
      { IFS= read -r dir; IFS= read -r cmd; IFS= read -r arg; } <<< "$out" || true
      local first="${cmd%% *}"
      first="${first/#\~/$HOME}"
      if ! command -v "$first" >/dev/null 2>&1; then
        echo -e "${RED}vdm: '$first' was not found.${NC} Shell aliases do not work here."
        echo -e "  Set the full command: ${CYAN}vdm config claude-cmd 'claude --your-flags'${NC}"
        return 1
      fi
      cd -- "$dir" || return 1
      echo -e "  ${DIM}In $dir, running: $cmd …${NC}"
      if [[ "$sub" == "resume" ]]; then
        exec bash -c "$cmd \"\$@\"" vdm-claude --resume "$arg"
      else
        exec bash -c "$cmd \"\$@\"" vdm-claude "$(cat -- "$arg")"
      fi
      ;;
    prompt)
      if [[ -z "${1:-}" ]]; then echo -e "${RED}Usage: vdm history prompt <id>${NC}"; return 1; fi
      local p
      p=$("${hist[@]}" prompt "$1") || return $?
      echo "$p"
      if command -v pbcopy >/dev/null 2>&1; then
        printf '%s' "$p" | pbcopy && echo -e "  ${GREEN}✓${NC} ${DIM}Copied. Paste it into a new Claude session.${NC}"
      fi
      ;;
    help|-h|--help)
      echo ""
      echo -e "${BOLD}  vdm history${NC}  - saved Claude Code sessions"
      echo ""
      echo -e "    ${CYAN}vdm history${NC} [--days N] [--all]   Recent sessions (--all: also automated ones)"
      echo -e "    ${CYAN}vdm history search${NC} <words>        Search everything said (file:x branch:x \"exact words\")"
      echo -e "    ${CYAN}vdm history show${NC} <id>             Details of one session"
      echo -e "    ${CYAN}vdm history prompt${NC} <id>           Copy a prompt that continues it in a new session"
      echo -e "    ${CYAN}vdm history continue${NC} <id>         Start a new session with the handoff loaded"
      echo -e "    ${CYAN}vdm history resume${NC} <id>           Resume the exact session (restores it if needed)"
      echo -e "    ${CYAN}vdm history restore${NC} <id>          Put a deleted session back for claude --resume"
      echo -e "    ${CYAN}vdm history delete${NC} <id>           Remove it from the archive (not from Claude Code)"
      echo ""
      echo -e "  ${DIM}<id> can be the first 8 characters. Turn saving on: vdm config history on${NC}"
      echo ""
      ;;
    *)
      "${hist[@]}" "$sub" "$@"
      ;;
  esac
}

