#!/usr/bin/env bash
# vdm - Van Damme-o-Matic
# Manages multiple Claude Code OAuth credential profiles via macOS Keychain.
# All running Claude Code sessions share the same Keychain entry,
# so switching here affects every open tab.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
ACCOUNTS_DIR="$SCRIPT_DIR/accounts"
KEYCHAIN_ACCOUNT="$(whoami)"
DASHBOARD_PORT="${CSW_PORT:-3333}"
PROXY_PORT="${CSW_PROXY_PORT:-3334}"
DASHBOARD_PID_FILE="$SCRIPT_DIR/.dashboard.pid"
CONFIG_FILE="$SCRIPT_DIR/config.json"
ACTIVITY_LOG_FILE="$SCRIPT_DIR/activity-log.json"
# Daemon (macOS LaunchAgent: runs as you, no admin password) and the menu bar icon
LAUNCH_LABEL="${VDM_LAUNCH_LABEL:-io.github.loekj.vdm}"
LAUNCH_DIR="${VDM_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
DAEMON_PLIST="$LAUNCH_DIR/$LAUNCH_LABEL.plist"
DAEMON_LOG="$SCRIPT_DIR/dashboard.log"
MENU_LABEL="$LAUNCH_LABEL.menubar"
MENU_PLIST="$LAUNCH_DIR/$MENU_LABEL.plist"
MENU_APP="$SCRIPT_DIR/VdmMenu.app"
GUI_DOMAIN="gui/$(id -u)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

mkdir -p "$ACCOUNTS_DIR"

# ─────────────────────────────────────────────────────────
# Startup migration: remove the Claude Code / git hooks older
# versions installed (token tracking moved into the proxy in v4)
# ─────────────────────────────────────────────────────────

if [[ -f "$SCRIPT_DIR/install-hooks.sh" ]] && grep -q "api/session-start" "$HOME/.claude/settings.json" 2>/dev/null; then
  source "$SCRIPT_DIR/install-hooks.sh"
  remove_legacy_hooks 2>/dev/null || true
fi

# ─────────────────────────────────────────────────────────
# Keychain service auto-detection
# ─────────────────────────────────────────────────────────

detect_keychain_service() {
  # Try the known default first
  if security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "Claude Code-credentials" -w &>/dev/null; then
    echo "Claude Code-credentials"
    return
  fi
  # Broader search for any Claude credential
  local svc
  svc=$(security dump-keychain 2>/dev/null | grep -A4 '"svce"' | grep -i claude | head -1 | sed -n 's/.*"svce"<blob>="\([^"]*\)".*/\1/p') || true
  if [[ -n "$svc" ]]; then
    echo "$svc"
    return
  fi
  # Fallback
  echo "Claude Code-credentials"
}

KEYCHAIN_SERVICE="$(detect_keychain_service)"

# ─────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────

read_keychain() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null
}

write_keychain() {
  local creds="$1"
  # Delete existing entry first (security won't overwrite)
  security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" 2>/dev/null || true
  # Write new entry
  security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w "$creds"
}

get_active_fingerprint() {
  local creds
  creds=$(read_keychain 2>/dev/null) || return 1
  echo "$creds" | python3 -c "
import sys, json, hashlib
d = json.load(sys.stdin)
token = d.get('claudeAiOauth', {}).get('accessToken', '')
print(hashlib.sha256(token.encode()).hexdigest()[:16])
" 2>/dev/null
}

get_profile_fingerprint() {
  local file="$1"
  python3 -c "
import sys, json, hashlib
with open('$file') as f:
    d = json.load(f)
token = d.get('claudeAiOauth', {}).get('accessToken', '')
print(hashlib.sha256(token.encode()).hexdigest()[:16])
" 2>/dev/null
}

get_profile_info() {
  local file="$1"
  python3 -c "
import sys, json, datetime
with open('$file') as f:
    d = json.load(f)
oauth = d.get('claudeAiOauth', {})
sub = oauth.get('subscriptionType', 'unknown')
tier = oauth.get('rateLimitTier', 'unknown')
expires = oauth.get('expiresAt', 0)
exp_str = datetime.datetime.fromtimestamp(expires/1000).strftime('%Y-%m-%d %H:%M') if expires else 'unknown'
# Clean up tier display
tier_short = tier.split('_')[-1] if '_' in tier else tier
print(f'{sub}|{tier_short}|{exp_str}')
" 2>/dev/null
}

fetch_account_email() {
  local token="$1"
  local org_name
  org_name=$(curl -s \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "User-Agent: claude-code/vdm" \
    "https://api.anthropic.com/api/oauth/claude_cli/roles" 2>/dev/null \
    | python3 -c "
import sys, json, re
try:
    d = json.load(sys.stdin)
    name = d.get('organization_name', '')
    # Extract email from 'user@email.com'\''s Organization'
    match = re.match(r\"(.+?)(?:'s Organization| Organization)$\", name)
    if match:
        print(match.group(1))
    else:
        print(name)
except:
    pass
" 2>/dev/null)
  echo "$org_name"
}

# $1 = subscription type, $2 = rate-limit tier. Anthropic renamed the plans (Nov 2026):
# Max 20x is now Ultra, Max 5x is now Max. Logins still report the old tier, so 20x reads as Ultra.
format_sub_type() {
  if [[ "$1" == ultra || "${2:-}" == *ultra* || ( "$1" == max && "${2:-}" == *20x* ) ]]; then
    echo -e "${BOLD}${CYAN}ULTRA${NC}"; return
  fi
  case "$1" in
    max) echo -e "${BOLD}${CYAN}MAX${NC}" ;;
    pro) echo -e "${BOLD}${BLUE}PRO${NC}" ;;
    free) echo -e "${DIM}FREE${NC}" ;;
    *) echo -e "${DIM}$1${NC}" ;;
  esac
}

# ─────────────────────────────────────────────────────────
# Activity log (shared with dashboard)
# ─────────────────────────────────────────────────────────

log_activity() {
  local type="$1"
  shift
  # Build JSON entry: { "ts": <epoch_ms>, "type": "<type>", ...extra }
  python3 -c "
import json, time, sys, os

log_file = '$ACTIVITY_LOG_FILE'
entry = {'ts': int(time.time() * 1000), 'type': '$type'}

# Parse extra key=value args
for arg in sys.argv[1:]:
    if '=' in arg:
        k, v = arg.split('=', 1)
        entry[k] = v

# Load existing log
log = []
try:
    with open(log_file) as f:
        log = json.load(f)
except:
    pass

log.insert(0, entry)
log = log[:200]  # max 200 entries

with open(log_file, 'w') as f:
    json.dump(log, f, indent=2)
" "$@" 2>/dev/null || true
}

# ─────────────────────────────────────────────────────────
# Config helpers
# ─────────────────────────────────────────────────────────

read_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    cat "$CONFIG_FILE"
  else
    echo '{"autoSwitch":true,"proxyEnabled":true,"rotationStrategy":"sticky","rotationIntervalMin":60}'
  fi
}

write_config() {
  echo "$1" > "$CONFIG_FILE"
}

get_config_value() {
  local key="$1"
  read_config | python3 -c "import sys,json; print(json.load(sys.stdin).get('$key', ''))" 2>/dev/null
}

set_config_value() {
  local key="$1"
  local value="$2"
  python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        cfg = json.load(f)
except:
    cfg = {'autoSwitch': True, 'proxyEnabled': True}
cfg['$key'] = $value
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
" 2>/dev/null
}

get_config_string() {
  local key="$1"
  read_config | python3 -c "import sys,json; print(json.load(sys.stdin).get('$key', ''))" 2>/dev/null
}

set_config_string() {
  local key="$1"
  local value="$2"
  python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        cfg = json.load(f)
except:
    cfg = {}
cfg['$key'] = '$value'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
" 2>/dev/null
}

set_config_number() {
  local key="$1"
  local value="$2"
  python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        cfg = json.load(f)
except:
    cfg = {}
cfg['$key'] = $value
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
" 2>/dev/null
}

# Set a free-text string (e.g. a launch command). The value goes in as an argument,
# never into the Python source, so quotes and $ in it are safe.
set_config_text() {
  python3 - "$CONFIG_FILE" "$1" "$2" <<'PYEOF' 2>/dev/null
import json, os, sys
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
cfg[key] = value
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    json.dump(cfg, f, indent=2)
os.replace(tmp, path)
PYEOF
}

# Best-effort: push the just-written key to a running dashboard so the change
# applies live (the dashboard otherwise only reads config.json at startup).
# Reads the value back from config.json so JSON typing (bool/number/string) is correct.
apply_setting_live() {
  local key="$1"
  local body
  body=$(read_config | python3 -c "import sys,json; c=json.load(sys.stdin); print(json.dumps({'$key': c.get('$key')}))" 2>/dev/null) || return 0
  [[ -z "$body" ]] && return 0
  curl -s --max-time 2 -X POST "http://localhost:$DASHBOARD_PORT/api/settings" \
    -H 'Content-Type: application/json' -d "$body" >/dev/null 2>&1 || true
}

# ─────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────

cmd_add() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo -e "${RED}Usage: vdm add <name>${NC}"
    echo "  Saves the currently logged-in credentials as a named profile."
    echo "  Example: vdm add work-account"
    return 1
  fi

  # Sanitize name
  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"

  local creds
  creds=$(read_keychain) || {
    echo -e "${RED}No credentials found in Keychain. Run 'claude login' first.${NC}"
    return 1
  }

  # Get profile info for display
  echo "$creds" > "$file"
  chmod 600 "$file"

  local info
  info=$(get_profile_info "$file")
  local sub_type=$(echo "$info" | cut -d'|' -f1)
  local tier=$(echo "$info" | cut -d'|' -f2)
  local expires=$(echo "$info" | cut -d'|' -f3)

  # Auto-fetch email from API
  local token
  token=$(echo "$creds" | python3 -c "import sys,json; print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])" 2>/dev/null)
  local email=""
  if [[ -n "$token" ]]; then
    email=$(fetch_account_email "$token")
  fi
  if [[ -n "$email" ]]; then
    echo "$email" > "$ACCOUNTS_DIR/${name}.label"
    echo "$email" > "$ACCOUNTS_DIR/${name}.email"
  fi

  echo -e "${GREEN}✓${NC} Saved profile ${BOLD}$name${NC}"
  if [[ -n "$email" ]]; then
    echo -e "  Email: ${CYAN}$email${NC}"
  fi
  echo -e "  Plan: $(format_sub_type "$sub_type" "$tier")  Tier: ${tier}"
  echo -e "  Token expires: ${DIM}$expires${NC}"

  log_activity "account-discovered" "name=$name" "label=${email:-$name}"
}

cmd_label() {
  local name="${1:-}"
  local label="${2:-}"
  if [[ -z "$name" || -z "$label" ]]; then
    echo -e "${RED}Usage: vdm label <name> <label>${NC}"
    echo "  Gives a profile a human-readable label (e.g. email or description)."
    echo "  Example: vdm label work-account john@company.com"
    return 1
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"
  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    return 1
  fi

  echo "$label" > "$ACCOUNTS_DIR/${name}.label"
  echo -e "${GREEN}✓${NC} Labeled ${BOLD}$name${NC} as ${CYAN}$label${NC}"

  log_activity "account-renamed" "name=$name" "label=$label"
}

cmd_list() {
  local active_fp
  active_fp=$(get_active_fingerprint 2>/dev/null) || active_fp=""

  local profiles=("$ACCOUNTS_DIR"/*.json)
  if [[ ! -f "${profiles[0]:-}" ]]; then
    echo -e "${YELLOW}No saved profiles. Use 'vdm add <name>' to save the current account.${NC}"
    return 0
  fi

  echo ""
  echo -e "${BOLD}  Van Damme-o-Matic Accounts${NC}"
  echo -e "  ─────────────────────────────────────────────"

  for file in "${profiles[@]}"; do
    local name=$(basename "$file" .json)
    local fp=$(get_profile_fingerprint "$file" 2>/dev/null)
    local info=$(get_profile_info "$file" 2>/dev/null)
    local sub_type=$(echo "$info" | cut -d'|' -f1)
    local tier=$(echo "$info" | cut -d'|' -f2)
    local expires=$(echo "$info" | cut -d'|' -f3)
    local label_file="$ACCOUNTS_DIR/${name}.label"
    local label=""
    [[ -f "$label_file" ]] && label=$(cat "$label_file")

    if [[ "$fp" == "$active_fp" ]]; then
      echo -e "  ${GREEN}▸ ${BOLD}$name${NC}  $(format_sub_type "$sub_type" "$tier")  ${GREEN}← active${NC}"
    else
      echo -e "    ${BOLD}$name${NC}  $(format_sub_type "$sub_type" "$tier")"
    fi
    if [[ -n "$label" ]]; then
      echo -e "      ${DIM}$label${NC}"
    fi
    echo -e "      ${DIM}tier: $tier  expires: $expires${NC}"
  done

  echo ""
}

cmd_switch() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    # Interactive mode: show numbered list
    local profiles=("$ACCOUNTS_DIR"/*.json)
    if [[ ! -f "${profiles[0]:-}" ]]; then
      echo -e "${YELLOW}No saved profiles. Use 'vdm add <name>' to save the current account.${NC}"
      return 1
    fi

    local active_fp
    active_fp=$(get_active_fingerprint 2>/dev/null) || active_fp=""

    echo ""
    echo -e "${BOLD}  Select account:${NC}"
    echo ""

    local i=1
    local names=()
    for file in "${profiles[@]}"; do
      local pname=$(basename "$file" .json)
      names+=("$pname")
      local fp=$(get_profile_fingerprint "$file" 2>/dev/null)
      local info=$(get_profile_info "$file" 2>/dev/null)
      local sub_type=$(echo "$info" | cut -d'|' -f1)
      local tier=$(echo "$info" | cut -d'|' -f2)
      local label_file="$ACCOUNTS_DIR/${pname}.label"
      local label=""
      [[ -f "$label_file" ]] && label=" ${DIM}($( cat "$label_file"))${NC}"

      if [[ "$fp" == "$active_fp" ]]; then
        echo -e "  ${GREEN}$i)${NC} ${BOLD}$pname${NC}  $(format_sub_type "$sub_type" "$tier")${label}  ${GREEN}← active${NC}"
      else
        echo -e "  $i) ${BOLD}$pname${NC}  $(format_sub_type "$sub_type" "$tier")${label}"
      fi
      ((i++))
    done

    echo ""
    read -rp "  Enter number (or q to cancel): " choice

    if [[ "$choice" == "q" || -z "$choice" ]]; then
      echo "  Cancelled."
      return 0
    fi

    if [[ "$choice" -ge 1 && "$choice" -le "${#names[@]}" ]] 2>/dev/null; then
      name="${names[$((choice-1))]}"
    else
      echo -e "  ${RED}Invalid choice.${NC}"
      return 1
    fi
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"

  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    echo "Available profiles:"
    ls "$ACCOUNTS_DIR"/*.json 2>/dev/null | xargs -I{} basename {} .json | sed 's/^/  /'
    return 1
  fi

  # A running dashboard does the switch: it also moves its request route and the sessions
  # (the login can already be this account while requests run on another)
  if curl -s --max-time 3 -X POST "http://localhost:$DASHBOARD_PORT/api/switch" \
       -H 'Content-Type: application/json' -d "{\"name\":\"$name\"}" 2>/dev/null | grep -q '"ok":true'; then
    echo -e "${GREEN}✓${NC} Switched to ${BOLD}$name${NC}"
    echo -e "${DIM}  All Claude Code sessions will use this account on their next API call.${NC}"
    return 0
  fi

  # Check if already active
  local active_fp=$(get_active_fingerprint 2>/dev/null)
  local target_fp=$(get_profile_fingerprint "$file" 2>/dev/null)
  if [[ "$active_fp" == "$target_fp" ]]; then
    echo -e "${YELLOW}Already on profile '$name'.${NC}"
    return 0
  fi

  local creds
  creds=$(cat "$file")
  write_keychain "$creds"

  local info=$(get_profile_info "$file" 2>/dev/null)
  local sub_type=$(echo "$info" | cut -d'|' -f1)
  local tier=$(echo "$info" | cut -d'|' -f2)
  local label_file="$ACCOUNTS_DIR/${name}.label"
  local label=""
  [[ -f "$label_file" ]] && label=$(cat "$label_file")

  echo -e "${GREEN}✓${NC} Switched to ${BOLD}$name${NC}  $(format_sub_type "$sub_type" "$tier")"
  echo -e "${DIM}  All Claude Code sessions will use this account on their next API call.${NC}"

  log_activity "manual-switch" "to=${label:-$name}"
}

cmd_remove() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo -e "${RED}Usage: vdm remove <name>${NC}"
    return 1
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"

  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    return 1
  fi

  rm -f "$file" "$ACCOUNTS_DIR/${name}.label" "$ACCOUNTS_DIR/${name}.email"
  echo -e "${GREEN}✓${NC} Removed profile ${BOLD}$name${NC}"
}

cmd_status() {
  local creds
  creds=$(read_keychain 2>/dev/null) || {
    echo -e "${RED}No credentials found in Keychain.${NC}"
    return 1
  }

  local active_fp=$(get_active_fingerprint 2>/dev/null)

  # Find matching profile
  local active_name="(not saved)"
  for file in "$ACCOUNTS_DIR"/*.json; do
    [[ -f "$file" ]] || continue
    local fp=$(get_profile_fingerprint "$file" 2>/dev/null)
    if [[ "$fp" == "$active_fp" ]]; then
      active_name=$(basename "$file" .json)
      break
    fi
  done

  local info
  info=$(echo "$creds" | python3 -c "
import sys, json, datetime
d = json.load(sys.stdin)
oauth = d.get('claudeAiOauth', {})
sub = oauth.get('subscriptionType', 'unknown')
tier = oauth.get('rateLimitTier', 'unknown')
expires = oauth.get('expiresAt', 0)
exp_str = datetime.datetime.fromtimestamp(expires/1000).strftime('%Y-%m-%d %H:%M') if expires else 'unknown'
scopes = ', '.join(oauth.get('scopes', []))
print(f'{sub}|{tier}|{exp_str}|{scopes}')
")

  local sub_type=$(echo "$info" | cut -d'|' -f1)
  local tier=$(echo "$info" | cut -d'|' -f2)
  local expires=$(echo "$info" | cut -d'|' -f3)
  local scopes=$(echo "$info" | cut -d'|' -f4)

  # Fetch email
  local token
  token=$(echo "$creds" | python3 -c "import sys,json; print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])" 2>/dev/null)
  local email=""
  if [[ -n "$token" ]]; then
    email=$(fetch_account_email "$token")
  fi

  echo ""
  echo -e "${BOLD}  Active Account${NC}"
  echo -e "  ────────────────────────────────"
  if [[ -n "$email" ]]; then
    echo -e "  Email:    ${CYAN}$email${NC}"
  fi
  # Only show profile name if it's a meaningful user-given name (not auto-generated)
  if [[ ! "$active_name" =~ ^auto-[0-9]+$ && "$active_name" != "(not saved)" ]]; then
    echo -e "  Profile:  ${BOLD}$active_name${NC}"
  fi
  echo -e "  Plan:     $(format_sub_type "$sub_type" "$tier")"
  echo -e "  Tier:     $tier"
  echo -e "  Expires:  $expires"
  echo -e "  Scopes:   ${DIM}$scopes${NC}"

  # Show proxy/auto-switch status
  local proxy_on=$(get_config_value "proxyEnabled")
  local auto_on=$(get_config_value "autoSwitch")
  local strategy=$(get_config_string "rotationStrategy")
  local interval=$(get_config_string "rotationIntervalMin")
  local notifs=$(get_config_value "notifications")
  local affinity=$(get_config_value "sessionAffinity")
  local history_on=$(get_config_value "sessionHistory")
  local keepwarm_on=$(get_config_value "keepWarm")
  echo ""
  echo -e "  ${BOLD}Settings${NC}"
  echo -e "  ────────────────────────────────"
  if [[ "$proxy_on" == "True" ]]; then
    echo -e "  Proxy:         ${GREEN}ON${NC}"
  else
    echo -e "  Proxy:         ${DIM}OFF${NC}"
  fi
  if [[ "$auto_on" == "True" ]]; then
    echo -e "  Auto-switch:   ${GREEN}ON${NC}"
  else
    echo -e "  Auto-switch:   ${DIM}OFF${NC}"
  fi
  if [[ "$notifs" == "True" ]]; then
    echo -e "  Notifications: ${GREEN}ON${NC}"
  else
    echo -e "  Notifications: ${DIM}OFF${NC}"
  fi
  echo -e "  Rotation:      ${CYAN}${strategy:-sticky}${NC}"
  if [[ "$affinity" == "False" ]]; then
    echo -e "  Affinity:      ${DIM}OFF${NC}"
  else
    echo -e "  Affinity:      ${GREEN}ON${NC}  ${DIM}(sessions stay on one account while their cache is warm)${NC}"
  fi
  if [[ "$keepwarm_on" == "False" ]]; then
    echo -e "  Keep-warm:     ${DIM}OFF${NC}  ${DIM}(vdm config keep-warm on)${NC}"
  else
    echo -e "  Keep-warm:     ${GREEN}ON${NC}  ${DIM}(idle sessions keep their prompt cache)${NC}"
  fi
  if [[ "$history_on" == "True" ]]; then
    echo -e "  History:       ${GREEN}ON${NC}  ${DIM}(sessions are saved: vdm history)${NC}"
  else
    echo -e "  History:       ${DIM}OFF${NC}  ${DIM}(vdm config history on)${NC}"
  fi
  if [[ "${strategy:-sticky}" == "round-robin" ]]; then
    echo -e "  Interval:      ${interval:-60} min"
  fi
  if [[ "${strategy:-sticky}" == "balance" ]]; then
    local cap=$(get_config_string "maxConcurrentPerAccount")
    echo -e "  Max/account:   ${cap:-8} in-flight"
    # Live in-flight spread from a running dashboard, if reachable
    local pstatus
    pstatus=$(curl -s --max-time 2 "http://localhost:$DASHBOARD_PORT/api/proxy-status" 2>/dev/null) || true
    if [[ -n "$pstatus" ]]; then
      echo "$pstatus" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
b = d.get('balance', {})
total = b.get('totalInflight', 0); waiting = b.get('waiting', 0)
print(f'  In-flight:     {total} total' + (f', {waiting} waiting for a slot' if waiting else ''))
rows = [(a.get('label') or a.get('name'), a.get('inflight', 0)) for a in d.get('accounts', []) if a.get('inflight')]
for name, n in sorted(rows, key=lambda r: -r[1]):
    print(f'                 {name}: {n}')
" 2>/dev/null || true
    fi
  fi

  # Version
  if [[ -f "$SCRIPT_DIR/.version" ]]; then
    echo -e "  Version:       ${DIM}$(cat "$SCRIPT_DIR/.version")${NC}"
  fi
  echo ""
}

cmd_config() {
  local key="${1:-}"
  local value="${2:-}"

  if [[ -z "$key" ]]; then
    # Show current config
    echo ""
    echo -e "${BOLD}  Settings${NC}"
    echo -e "  ────────────────────────────────"
    local proxy_on=$(get_config_value "proxyEnabled")
    local auto_on=$(get_config_value "autoSwitch")
    local strategy=$(get_config_string "rotationStrategy")
    local interval=$(get_config_string "rotationIntervalMin")
    if [[ "$proxy_on" == "True" ]]; then
      echo -e "  proxyEnabled:       ${GREEN}on${NC}"
    else
      echo -e "  proxyEnabled:       ${DIM}off${NC}"
    fi
    if [[ "$auto_on" == "True" ]]; then
      echo -e "  autoSwitch:         ${GREEN}on${NC}"
    else
      echo -e "  autoSwitch:         ${DIM}off${NC}"
    fi
    local notifs=$(get_config_value "notifications")
    if [[ "$notifs" == "True" ]]; then
      echo -e "  notifications:      ${GREEN}on${NC}"
    else
      echo -e "  notifications:      ${DIM}off${NC}"
    fi
    echo -e "  rotationStrategy:   ${CYAN}${strategy:-sticky}${NC}"
    echo -e "  rotationIntervalMin: ${interval:-60}"
    local serialize=$(get_config_value "serializeRequests")
    if [[ "$serialize" == "True" ]]; then
      echo -e "  serializeRequests:  ${GREEN}on${NC}  ${DIM}[BETA]${NC}"
    else
      echo -e "  serializeRequests:  ${DIM}off${NC}  ${DIM}[BETA]${NC}"
    fi
    local delay=$(get_config_string "serializeDelayMs")
    echo -e "  serializeDelayMs:   ${delay:-200}  ${DIM}[BETA]${NC}"
    local maxconc=$(get_config_string "maxConcurrentPerAccount")
    if [[ "$strategy" == "balance" ]]; then
      echo -e "  maxConcurrentPerAccount: ${GREEN}${maxconc:-8}${NC}  ${DIM}[BETA] per-account in-flight cap${NC}"
    else
      echo -e "  maxConcurrentPerAccount: ${maxconc:-8}  ${DIM}[BETA] (only used by rotation=balance)${NC}"
    fi
    local affinity=$(get_config_value "sessionAffinity")
    if [[ "$affinity" == "False" ]]; then
      echo -e "  sessionAffinity:    ${DIM}off${NC}"
    else
      echo -e "  sessionAffinity:    ${GREEN}on${NC}"
    fi
    local kw=$(get_config_value "keepWarm")
    if [[ "$kw" == "False" ]]; then
      echo -e "  keepWarm:           ${DIM}off${NC}"
    else
      echo -e "  keepWarm:           ${GREEN}on${NC}"
    fi
    local hist=$(get_config_value "sessionHistory")
    if [[ "$hist" == "True" ]]; then
      echo -e "  sessionHistory:     ${GREEN}on${NC}"
    else
      echo -e "  sessionHistory:     ${DIM}off${NC}"
    fi
    local ccmd=$(get_config_string "claudeCommand")
    echo -e "  claudeCommand:      ${CYAN}${VDM_CLAUDE_CMD:-${ccmd:-claude}}${NC}${VDM_CLAUDE_CMD:+  ${DIM}(from VDM_CLAUDE_CMD)${NC}}"
    local keep=$(get_config_string "historyRetentionDays")
    if [[ -z "$keep" || "$keep" == "0" ]]; then
      echo -e "  historyRetentionDays: forever"
    else
      echo -e "  historyRetentionDays: ${keep}"
    fi
    echo ""
    echo -e "  ${DIM}Usage: vdm config <key> <value>${NC}"
    echo -e "  ${DIM}  vdm config proxy on${NC}"
    echo -e "  ${DIM}  vdm config autoswitch off${NC}"
    echo -e "  ${DIM}  vdm config notifications off${NC}"
    echo -e "  ${DIM}  vdm config rotation sticky|conserve|round-robin|spread|drain-first|balance${NC}"
    echo -e "  ${DIM}  vdm config interval 15|30|60|120${NC}"
    echo -e "  ${DIM}  vdm config max-concurrent 1-50${NC}  ${DIM}[BETA] per-account cap for rotation=balance${NC}"
    echo -e "  ${DIM}  vdm config serialize on|off${NC}  ${DIM}[BETA]${NC}"
    echo -e "  ${DIM}  vdm config serialize-delay 0|100|200|500|1000${NC}  ${DIM}[BETA]${NC}"
    echo -e "  ${DIM}  vdm config affinity on|off${NC}  ${DIM}keep each session on one account (saves prompt cache)${NC}"
    echo -e "  ${DIM}  vdm config history on|off${NC}  ${DIM}save sessions to search and continue later${NC}"
    echo -e "  ${DIM}  vdm config keep-warm on|off${NC}  ${DIM}keep idle sessions' prompt cache warm (learned limits)${NC}"
    echo -e "  ${DIM}  vdm config claude-cmd 'claude --flags'${NC}  ${DIM}how vdm starts Claude Code (full command, not an alias)${NC}"
    echo -e "  ${DIM}  vdm config history-keep 0|90|180|365|730${NC}  ${DIM}days to keep saved sessions (0 = forever)${NC}"
    echo -e "  ${DIM}  vdm config terminal auto|iterm|terminal${NC}  ${DIM}where History → Open starts sessions${NC}"
    return 0
  fi

  # Normalize key
  local is_bool=true
  case "$key" in
    proxy|proxyEnabled|proxy-enabled)       key="proxyEnabled" ;;
    autoswitch|autoSwitch|auto-switch)    key="autoSwitch" ;;
    notifications|notifs)                 key="notifications" ;;
    rotation|rotationStrategy|strategy)   key="rotationStrategy"; is_bool=false ;;
    interval|rotationIntervalMin)         key="rotationIntervalMin"; is_bool=false ;;
    serialize|serializeRequests|serialize-requests) key="serializeRequests" ;;
    serialize-delay|serializeDelayMs|serialize-delay-ms) key="serializeDelayMs"; is_bool=false ;;
    max-concurrent|maxConcurrentPerAccount|max-concurrent-per-account) key="maxConcurrentPerAccount"; is_bool=false ;;
    affinity|sessionAffinity|session-affinity) key="sessionAffinity" ;;
    history|sessionHistory|session-history) key="sessionHistory" ;;
    keep-warm|keepWarm|keepwarm) key="keepWarm" ;;
    claude-cmd|claudeCommand|claude-command) key="claudeCommand"; is_bool=false
      # Allow it unquoted: vdm config claude-cmd claude --dangerously-skip-permissions
      if [[ $# -gt 2 ]]; then shift; value="$*"; fi ;;
    history-keep|historyRetentionDays|history-retention) key="historyRetentionDays"; is_bool=false ;;
    terminal|terminalApp|terminal-app) key="terminalApp"; is_bool=false ;;
    *)
      echo -e "${RED}Unknown setting: $key${NC}"
      echo "  Available: proxy, autoswitch, notifications, rotation, interval, max-concurrent, serialize, serialize-delay, affinity, history, keep-warm, claude-cmd, history-keep, terminal"
      return 1
      ;;
  esac

  if [[ -z "$value" ]]; then
    if [[ "$is_bool" == "true" ]]; then
      local current=$(get_config_value "$key")
      echo "$key = $current"
    else
      local current=$(get_config_string "$key")
      echo "$key = $current"
    fi
    return 0
  fi

  if [[ "$is_bool" == "true" ]]; then
    # Boolean setting
    case "$value" in
      on|true|1|yes)   value="True" ;;
      off|false|0|no)  value="False" ;;
      *)
        echo -e "${RED}Invalid value: $value${NC}  (use on/off)"
        return 1
        ;;
    esac
    set_config_value "$key" "$value"
    if [[ "$value" == "True" ]]; then
      echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${GREEN}on${NC}"
    else
      echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${DIM}off${NC}"
    fi
  elif [[ "$key" == "rotationStrategy" ]]; then
    case "$value" in
      sticky|conserve|round-robin|spread|drain-first|balance) ;;
      *)
        echo -e "${RED}Invalid strategy: $value${NC}"
        echo "  Options: sticky, conserve, round-robin, spread, drain-first, balance"
        return 1
        ;;
    esac
    set_config_string "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}$value${NC}"
    if [[ "$value" == "balance" ]]; then
      local cap=$(get_config_string "maxConcurrentPerAccount")
      echo -e "  ${DIM}Spreading load across accounts, max ${cap:-8} in-flight each. Tune: vdm config max-concurrent N${NC}"
    fi
  elif [[ "$key" == "rotationIntervalMin" ]]; then
    case "$value" in
      15|30|60|120) ;;
      *)
        echo -e "${RED}Invalid interval: $value${NC}  (use 15, 30, 60, or 120)"
        return 1
        ;;
    esac
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value} min${NC}"
  elif [[ "$key" == "serializeDelayMs" ]]; then
    case "$value" in
      0|100|200|500|1000|2000) ;;
      *)
        echo -e "${RED}Invalid delay: $value${NC}  (use 0, 100, 200, 500, 1000, or 2000)"
        return 1
        ;;
    esac
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value} ms${NC}"
  elif [[ "$key" == "maxConcurrentPerAccount" ]]; then
    if ! [[ "$value" =~ ^[0-9]+$ ]] || (( 10#$value < 1 || 10#$value > 50 )); then
      echo -e "${RED}Invalid value: $value${NC}  (use a number 1-50)"
      return 1
    fi
    value=$((10#$value))
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value}${NC}  ${DIM}concurrent in-flight per account${NC}"
  elif [[ "$key" == "terminalApp" ]]; then
    case "$value" in
      auto|iterm|terminal) ;;
      *) echo -e "${RED}Invalid terminal: $value${NC}  (use auto, iterm or terminal)"; return 1 ;;
    esac
    set_config_string "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}$value${NC}  ${DIM}(History → Open uses it)${NC}"
  elif [[ "$key" == "claudeCommand" ]]; then
    if [[ ${#value} -gt 300 || "$value" == *$'\n'* ]]; then
      echo -e "${RED}Invalid command${NC}  (one line, max 300 characters)"
      return 1
    fi
    local first="${value%% *}"
    first="${first/#\~/$HOME}"
    if ! command -v "$first" >/dev/null 2>&1; then
      echo -e "${YELLOW}Note:${NC} '$first' is not a program. Fine for an alias: History → Open runs it in your shell. Copied commands and vdm history resume need the full command."
    fi
    set_config_text "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value}${NC}"
  elif [[ "$key" == "historyRetentionDays" ]]; then
    if ! [[ "$value" =~ ^[0-9]+$ ]] || (( 10#$value > 3650 )); then
      echo -e "${RED}Invalid value: $value${NC}  (days, 0 = forever)"
      return 1
    fi
    value=$((10#$value))
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value}${NC}  ${DIM}(0 = keep forever)${NC}"
  fi
  if [[ "$key" == "keepWarm" && "$value" == "True" ]]; then
    echo -e "  ${DIM}Idle sessions now keep their prompt cache. Savings: Usage tab → Smart cache.${NC}"
  fi
  if [[ "$key" == "sessionHistory" && "$value" == "True" ]]; then
    echo -e "  ${DIM}Saving your sessions now. Browse them: vdm history, or the History tab in the dashboard.${NC}"
  fi

  # Apply live to a running dashboard so the change takes effect without a restart.
  apply_setting_live "$key"

  log_activity "settings-changed" "$key=$value"
}

cmd_dashboard() {
  local action="${1:-start}"

  case "$action" in
    stop)
      if daemon_loaded; then
        # SIGTERM = a clean exit, so launchd does not restart it (until login or vdm dashboard start)
        launchctl kill SIGTERM "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null || true
        if wait_port_free "$DASHBOARD_PORT" 10; then
          echo -e "${GREEN}✓${NC} Dashboard stopped. ${DIM}The daemon starts it at your next login, or now with: vdm dashboard start${NC}"
          return 0
        fi
        echo -e "${YELLOW}Port $DASHBOARD_PORT is still in use (PID $(port_pid "$DASHBOARD_PORT")).${NC}"
        return 1
      fi
      # Try PID file first, then fall back to port-based detection
      local stopped=false
      if [[ -f "$DASHBOARD_PID_FILE" ]]; then
        local pid=$(cat "$DASHBOARD_PID_FILE")
        if kill "$pid" 2>/dev/null; then
          stopped=true
        fi
        rm -f "$DASHBOARD_PID_FILE"
      fi
      if [[ "$stopped" != "true" ]]; then
        # Find by port
        local pid
        pid=$(lsof -iTCP:"$DASHBOARD_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) || true
        if [[ -n "$pid" ]]; then
          kill "$pid" 2>/dev/null
          stopped=true
        fi
      fi
      if [[ "$stopped" == "true" ]]; then
        wait_port_free "$DASHBOARD_PORT" 10 || true
        wait_port_free "$PROXY_PORT" 5 || true
        echo -e "${GREEN}✓${NC} Dashboard stopped."
      else
        echo -e "${YELLOW}Dashboard was not running.${NC}"
      fi
      ;;
    start|"")
      # Check if already running (by PID file or port)
      if [[ -f "$DASHBOARD_PID_FILE" ]]; then
        local pid=$(cat "$DASHBOARD_PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
          echo -e "${YELLOW}Dashboard already running at http://localhost:$DASHBOARD_PORT${NC}"
          echo -e "${DIM}Use 'vdm dashboard stop' to stop it.${NC}"
          return 0
        fi
        rm -f "$DASHBOARD_PID_FILE"
      fi
      # Also check by port
      if lsof -iTCP:"$DASHBOARD_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
        echo -e "${YELLOW}Dashboard already running at http://localhost:$DASHBOARD_PORT${NC}"
        echo -e "${DIM}Use 'vdm dashboard stop' to stop it.${NC}"
        return 0
      fi

      if daemon_installed; then
        echo -e "${BLUE}Starting vdm (daemon)…${NC}"
        if daemon_start; then
          echo -e "${GREEN}✓${NC} Dashboard running: ${CYAN}http://localhost:$DASHBOARD_PORT${NC}"
          [[ "${2:-}" == "--no-open" ]] || open "http://localhost:$DASHBOARD_PORT" 2>/dev/null || true
          return 0
        fi
        if port_listening "$DASHBOARD_PORT"; then
          echo -e "${RED}vdm did not stay up.${NC} See ${DIM}$DAEMON_LOG${NC}"
          return 1
        fi
        # No GUI login (e.g. only SSH) or launchd refused: run it the old way
        echo -e "${YELLOW}The daemon could not start${NC} ${DIM}(see $DAEMON_LOG)${NC}. Starting vdm without it."
      fi
      echo -e "${BLUE}Starting dashboard on http://localhost:$DASHBOARD_PORT${NC}"
      node "$SCRIPT_DIR/dashboard.mjs" &
      local pid=$!
      echo "$pid" > "$DASHBOARD_PID_FILE"

      # Wait a moment then open
      sleep 0.5
      if kill -0 "$pid" 2>/dev/null; then
        echo -e "${GREEN}✓${NC} Dashboard running (PID $pid)"
        echo -e "  Dashboard: ${CYAN}http://localhost:$DASHBOARD_PORT${NC}"
        echo -e "  API Proxy: ${CYAN}http://localhost:$PROXY_PORT${NC}"
        open "http://localhost:$DASHBOARD_PORT" 2>/dev/null || echo -e "  Open http://localhost:$DASHBOARD_PORT in your browser"
      else
        echo -e "${RED}Dashboard failed to start. Check Node.js is installed.${NC}"
        rm -f "$DASHBOARD_PID_FILE"
        return 1
      fi
      ;;
    *)
      echo -e "${RED}Usage: vdm dashboard [start|stop]${NC}"
      ;;
  esac
}

# ─────────────────────────────────────────────────────────
# Daemon: launchd starts vdm at login and again after a crash
# ─────────────────────────────────────────────────────────

daemon_installed() { [[ -f "$DAEMON_PLIST" ]]; }
daemon_loaded() { launchctl print "$GUI_DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1; }
port_listening() { lsof -iTCP:"$1" -sTCP:LISTEN -t >/dev/null 2>&1; }

wait_for_port() { # port, seconds
  local i
  for ((i = 0; i < $2 * 4; i++)); do port_listening "$1" && return 0; sleep 0.25; done
  return 1
}
wait_port_free() {
  local i
  for ((i = 0; i < $2 * 4; i++)); do port_listening "$1" || return 0; sleep 0.25; done
  return 1
}

# Write a LaunchAgent plist. Args: path label program [args...]. Env: PLIST_KEEPALIVE=1, PLIST_LOG=file.
# Settings vdm reads from the environment (CSW_*, VDM_CLAUDE_CMD) go along, so the daemon
# behaves like the shell that turned it on.
write_plist() {
  local path="$1"; shift
  mkdir -p "$(dirname "$path")"
  python3 - "$path" "$@" <<'PY'
import os, plistlib, sys
path, label, *args = sys.argv[1:]
home = os.environ["HOME"]
keep = lambda k: k.startswith("CSW_") or k in ("VDM_CLAUDE_CMD", "OAUTH_TOKEN_URL")
env = {}
# Settings saved by an earlier `vdm daemon on` stay (e.g. a custom CSW_PORT); this shell's win
try:
    old = plistlib.load(open(path, "rb")).get("EnvironmentVariables", {})
    env.update({k: v for k, v in old.items() if keep(k)})
except Exception:
    pass
env.update({k: v for k, v in os.environ.items() if keep(k)})
node = os.environ.get("PLIST_NODE", "")
dirs = [os.path.dirname(node) if node else "", home + "/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
env["PATH"] = ":".join(d for i, d in enumerate(dirs) if d and d not in dirs[:i])
env["VDM_LAUNCH_LABEL"] = os.environ.get("VDM_LAUNCH_LABEL") or (label[:-len(".menubar")] if label.endswith(".menubar") else label)
if node:
    # Node moved (nvm/fnm/volta switch, brew reinstall)? Fall back to the usual places.
    env["VDM_NODE"] = node
    args = ["/bin/sh", "-c", 'for n in "$VDM_NODE" /opt/homebrew/bin/node /usr/local/bin/node; do [ -x "$n" ] && exec "$n" "$0"; done; echo "vdm: Node.js not found (run: vdm daemon on)" >&2; exit 1'] + args
p = {"Label": label, "ProgramArguments": args, "RunAtLoad": True, "EnvironmentVariables": env,
     "WorkingDirectory": os.path.dirname(os.path.abspath(args[-1])) if args[-1].endswith(".mjs") else home}
if os.environ.get("PLIST_KEEPALIVE") == "1":
    p["KeepAlive"] = {"SuccessfulExit": False}   # restart after a crash, not after vdm dashboard stop
    p["ThrottleInterval"] = 10
    p["ProcessType"] = "Interactive"             # every Claude request streams through it: no throttling
    p["AbandonProcessGroup"] = True              # sessions started with `claude --bg` outlive a restart
if os.environ.get("PLIST_LOG"):
    p["StandardOutPath"] = p["StandardErrorPath"] = os.environ["PLIST_LOG"]
    env["VDM_DAEMON_LOG"] = os.environ["PLIST_LOG"]
if label.endswith(".menubar"):
    p["LimitLoadToSessionType"] = "Aqua"
    p["ProcessType"] = "Interactive"
with open(path + ".tmp", "wb") as f:
    plistlib.dump(p, f)
os.replace(path + ".tmp", path)
PY
}

# The real Node binary, not a version-manager shim or a per-shell link (asdf, mise, fnm)
real_node() {
  local n; n="$(command -v node)" || return 1
  "$n" -e 'process.stdout.write(process.execPath)' 2>/dev/null || echo "$n"
}

write_daemon_plist() {
  local node_bin
  node_bin="$(real_node)" || { echo -e "${RED}Node.js was not found.${NC}"; return 1; }
  PLIST_KEEPALIVE=1 PLIST_LOG="$DAEMON_LOG" PLIST_NODE="$node_bin" write_plist "$DAEMON_PLIST" "$LAUNCH_LABEL" "$SCRIPT_DIR/dashboard.mjs"
}

# Load (or reload) the daemon so it reads its plist again, then wait for the dashboard.
daemon_pid() { launchctl print "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null | awk '/^\tpid = /{print $3}' || true; }
port_pid() { lsof -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1 || true; }

# Load a LaunchAgent: a few tries (right after a bootout, launchd may still be busy with it).
# Turned off under Login Items? `vdm … on` means on: enable it again. Prints launchctl's error.
load_agent() { # label plist
  local i err=""
  launchctl enable "$GUI_DOMAIN/$1" 2>/dev/null || true
  for i in 1 2 3 4 5; do
    err=$(launchctl bootstrap "$GUI_DOMAIN" "$2" 2>&1) && return 0
    launchctl print "$GUI_DOMAIN/$1" >/dev/null 2>&1 && { launchctl kickstart "$GUI_DOMAIN/$1" 2>/dev/null; return 0; }
    sleep 1
  done
  echo -e "  ${DIM}launchctl: ${err}${NC}" >&2
  return 1
}

daemon_start() {
  launchctl bootout "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null || true
  wait_port_free "$DASHBOARD_PORT" 10 || true
  wait_port_free "$PROXY_PORT" 5 || true
  load_agent "$LAUNCH_LABEL" "$DAEMON_PLIST" || return 1   # e.g. no GUI login (SSH only)
  wait_for_port "$DASHBOARD_PORT" 15 && wait_for_port "$PROXY_PORT" 5 || return 1
  sleep 1   # still up a moment later? (another vdm on the port makes it exit)
  local pid; pid=$(daemon_pid)
  if [[ -z "$pid" || "$(port_pid "$DASHBOARD_PORT")" != "$pid" ]]; then
    echo -e "  ${YELLOW}Another vdm holds port $DASHBOARD_PORT (PID $(port_pid "$DASHBOARD_PORT")).${NC} Stop it, then: vdm daemon restart" >&2
    return 1
  fi
}

# vdm started the old way (from the shell, no launchd): stop it
stop_plain_dashboard() {
  local pid
  if [[ -f "$DASHBOARD_PID_FILE" ]]; then kill "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null || true; rm -f "$DASHBOARD_PID_FILE"; fi
  pid=$(lsof -iTCP:"$DASHBOARD_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) || true
  [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
  wait_port_free "$DASHBOARD_PORT" 10 || true
  wait_port_free "$PROXY_PORT" 5 || true
}

# The shell block: sets ANTHROPIC_BASE_URL; starts vdm only when the daemon is not installed.
shell_block() {
  cat <<SHELL_EOF
# BEGIN claude-account-switcher
if ! lsof -iTCP:3333 -sTCP:LISTEN -t >/dev/null 2>&1; then
  # The daemon (vdm daemon on) runs vdm when it is loaded; else start it here
  if ! { [ -f "\$HOME/Library/LaunchAgents/$LAUNCH_LABEL.plist" ] && launchctl print "gui/\$(id -u)/$LAUNCH_LABEL" >/dev/null 2>&1; }; then
    nohup node ~/.claude/account-switcher/dashboard.mjs >/dev/null 2>&1 &
    disown
  fi
fi
export ANTHROPIC_BASE_URL=http://localhost:3334
# END claude-account-switcher
SHELL_EOF
}

# Add the shell block, or replace older ones (in every shell file that has one).
# Writes through symlinks (dotfile repos) and keeps the file mode. Prints the file(s).
cmd_setup_shell() {
  local f found=()
  for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.zprofile" "$HOME/.profile"; do
    if [[ -f "$f" ]] && grep -q "^# BEGIN claude-account-switcher" "$f"; then found+=("$f"); fi
  done
  local block
  block="$(shell_block)"
  if [[ ${#found[@]} -gt 0 ]]; then
    for f in "${found[@]}"; do
      BLOCK="$block" python3 - "$f" <<'PY'
import os, re, shutil, sys, tempfile
path = os.path.realpath(sys.argv[1])          # a symlink (dotfiles repo): change the real file
text = open(path).read()
new = re.sub(r"(?ms)^# BEGIN claude-account-switcher\n.*?^# END claude-account-switcher\n?", lambda m: os.environ["BLOCK"] + "\n", text, count=1)
if new != text:
    shutil.copy2(path, path + ".vdm-backup")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".vdm-")
    with os.fdopen(fd, "w") as f:
        f.write(new)
    shutil.copymode(path, tmp)
    os.replace(tmp, path)
PY
    done
    echo "${found[0]}"
    return 0
  fi
  local rc=""
  for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do [[ -f "$f" ]] && { rc="$f"; break; }; done
  if [[ -z "$rc" ]]; then
    # A new Mac has no shell file yet: make the one your login shell reads
    case "$(basename "${SHELL:-/bin/zsh}")" in
      zsh) rc="$HOME/.zshrc" ;;
      bash) rc="$HOME/.bash_profile" ;;
      *) echo ""; return 1 ;;
    esac
    touch "$rc"
  fi
  printf '\n%s\n' "$block" >> "$rc"
  echo "$rc"
}

cmd_daemon() {
  local action="${1:-status}"
  case "$action" in
    on|install)
      if [[ "$(uname)" != "Darwin" ]]; then echo -e "${RED}The daemon needs macOS (launchd).${NC}"; return 1; fi
      local node_bin; node_bin="$(real_node || true)"
      if [[ "$node_bin" != /opt/homebrew/* && "$node_bin" != /usr/local/* ]]; then
        echo -e "${YELLOW}Note:${NC} Node is at ${DIM}$node_bin${NC}. If that path changes (new Node version), run ${CYAN}vdm daemon on${NC} again."
      fi
      write_daemon_plist || return 1
      if ! daemon_loaded; then stop_plain_dashboard; fi
      cmd_setup_shell >/dev/null || true
      if daemon_start; then
        echo -e "${GREEN}✓${NC} Daemon on: vdm starts when you log in, and again after a crash."
        echo -e "  ${DIM}macOS may show \"Background item added\". No admin password is needed.${NC}"
        echo -e "  ${DIM}Log: $DAEMON_LOG${NC}"
      else
        echo -e "${RED}The daemon did not start within 15 s.${NC} See ${DIM}$DAEMON_LOG${NC}"
        return 1
      fi
      ;;
    off|uninstall)
      local had=false
      if daemon_loaded; then launchctl bootout "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null || true; had=true; fi
      [[ -f "$DAEMON_PLIST" ]] && { rm -f "$DAEMON_PLIST"; had=true; }
      wait_port_free "$DASHBOARD_PORT" 10 || true
      wait_port_free "$PROXY_PORT" 5 || true
      if [[ "${2:-}" != "--no-start" ]] && ! port_listening "$DASHBOARD_PORT"; then
        # Keep the proxy up: start it the old way (your shell also does this in new terminals)
        nohup node "$SCRIPT_DIR/dashboard.mjs" >/dev/null 2>&1 &
        echo $! > "$DASHBOARD_PID_FILE"
        disown 2>/dev/null || true
        wait_for_port "$DASHBOARD_PORT" 10 || echo -e "${RED}vdm did not start.${NC} Run: vdm dashboard start"
      fi
      if [[ "$had" == "true" ]]; then echo -e "${GREEN}✓${NC} Daemon off. New terminals start vdm again, as before."
      else echo -e "${DIM}The daemon was not installed.${NC}"; fi
      ;;
    restart)
      if ! daemon_installed; then echo -e "${YELLOW}The daemon is off.${NC} Turn it on: ${CYAN}vdm daemon on${NC}"; return 1; fi
      daemon_start && echo -e "${GREEN}✓${NC} vdm restarted" || { echo -e "${RED}vdm did not start.${NC} See ${DIM}$DAEMON_LOG${NC}"; return 1; }
      ;;
    status)
      if daemon_installed; then
        local pid; pid=$(launchctl print "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null | awk '/^\tpid = /{print $3}') || true
        local node_bin; node_bin=$(plutil -extract EnvironmentVariables.VDM_NODE raw "$DAEMON_PLIST" 2>/dev/null) || true
        if [[ -n "$node_bin" && ! -x "$node_bin" ]]; then
          echo -e "${YELLOW}!${NC} The daemon's Node ($node_bin) is gone. Run ${CYAN}vdm daemon on${NC} to use the current one."
        fi
        if [[ -n "$pid" ]]; then echo -e "${GREEN}●${NC} Daemon on, running (PID $pid)"
        elif daemon_loaded; then echo -e "${YELLOW}●${NC} Daemon on, stopped. Start it: ${CYAN}vdm dashboard start${NC}"
        else echo -e "${YELLOW}●${NC} Daemon installed, not loaded. Start it: ${CYAN}vdm daemon on${NC}"; fi
        echo -e "  ${DIM}Log: $DAEMON_LOG${NC}"
      else
        echo -e "${DIM}●${NC} Daemon off (your shell starts vdm). Turn it on: ${CYAN}vdm daemon on${NC}"
      fi
      if port_listening "$DASHBOARD_PORT"; then echo -e "  Dashboard: ${CYAN}http://localhost:$DASHBOARD_PORT${NC}"; else echo -e "  ${RED}Dashboard is not running${NC}"; fi
      ;;
    *) echo -e "${RED}Usage: vdm daemon [on|off|restart|status]${NC}"; return 1 ;;
  esac
}

