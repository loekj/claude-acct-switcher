# ─────────────────────────────────────────────────────────
# Main dispatch
# ─────────────────────────────────────────────────────────

# Wrapped in a function and exited on the same line: bash reads scripts as it runs them,
# so nothing after this line is read even if the file changes during the command.
main() {
  command="${1:-help}"
  shift 2>/dev/null || true

  case "$command" in
    add)       cmd_add "$@" ;;
    label)     cmd_label "$@" ;;
    list|ls)   cmd_list ;;
    switch|sw) cmd_switch "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    status|st) cmd_status ;;
    config|cfg) cmd_config "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    logs|log) cmd_logs "$@" ;;
    tokens|tok) cmd_tokens "$@" ;;
    history|hist) cmd_history "$@" ;;
    upgrade|update) cmd_upgrade ;;
    help|--help|-h) cmd_help ;;
    *)
      echo -e "${RED}Unknown command: $command${NC}"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"; exit $?
