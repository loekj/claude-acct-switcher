  echo ""
  echo -e "  ${BOLD}USAGE${NC}"
  echo -e "    vdm <command> [args]"
  echo ""
  echo -e "  ${BOLD}COMMANDS${NC}"
  echo -e "    ${CYAN}list${NC}                    List all saved profiles"
